{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3",
      "includeFiles": "**"
    }
  },
  "routes": [
    {
      "src": "^/assets/(.*)$",
      "dest": "/assets/$1"
    },
    {
      "src": "^/(dashboard\\.css|style\\.css|societies\\.json)$",
      "dest": "/$1"
    },
    {
      "src": "^/(.*\\.(css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|webp))$",
      "dest": "/$1"
    },
    {
      "src": "^/shivam/(.*)$",
      "dest": "/api/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}